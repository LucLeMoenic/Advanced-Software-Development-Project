# Shared local Ollama configuration. Add any model required by a team service
# to this space-separated inventory; pull each tag with native ollama pull.
OLLAMA_MODELS=llama3.2:3b qwen2.5-coder:7b qwen2.5:3b
IMPLEMENTER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=llama3.2:3b

# Each consumer selects one model hosted by the shared Ollama service.
APPLICATION_MODEL=llama3.2:3b
AI_ENABLED=true
# MCP_ENABLED/RAG_ENABLED are shared by the Student 1, 2, 3 and 5
# backends. Student 1/2/5's compose defaults are false (CI); Student 3's
# compose default is true, since its own MCP/RAG panels are the point of
# its Stage 3 UI - CI overrides all three to false regardless of default,
# so this only matters for a bare `docker compose up` with no .env file.
# Set both to true here for the local demo after starting native Ollama,
# MCP (:5400) and RAG (:5500).
MCP_ENABLED=true
RAG_ENABLED=true
MCP_SERVER_URL=http://host.docker.internal:5400/mcp
RAG_SERVER_URL=http://host.docker.internal:5500
RAG_MODEL=llama3.2:3b
# Override only when host-gateway points at a container VM rather than Windows.
# Use a private host interface reachable from the container network.
LOCAL_AI_HOST=host-gateway

# Student 4 (Budget & Expense Tracker) uses Llama for optional strict-JSON advice.
STUDENT4_MODEL=llama3.2:3b

# Student 3 (Local Experience & Attraction Recommender) calls Qwen directly.
# qwen2.5 with no tag pulls the 7B variant, which gets OOM-killed under a
# memory-constrained development machine - 3b is the practical default.
STUDENT3_MODEL=qwen2.5:3b

# Create a free sandbox key at https://www.liteapi.travel/ and keep it out of
# source control. Only the Student 1 backend receives this value.
LITEAPI_KEY=
