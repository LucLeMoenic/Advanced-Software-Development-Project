# Shared local Ollama configuration
IMPLEMENTER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=llama3.2:3b

# The accommodation application calls one model only. Reusing the reviewer model
# keeps the local setup to two unique model downloads.
APPLICATION_MODEL=llama3.2:3b

# Create a free sandbox key at https://www.liteapi.travel/ and keep it out of
# source control. Only the Student 1 backend receives this value.
LITEAPI_KEY=
