# Shared local Ollama configuration. Add any model required by a team service
# to this space-separated list; one shared runtime stores and serves them all.
OLLAMA_MODELS=llama3.2:3b qwen2.5-coder:7b
IMPLEMENTER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=llama3.2:3b

# Each consumer selects one model hosted by the shared Ollama service.
APPLICATION_MODEL=llama3.2:3b

# Create a free sandbox key at https://www.liteapi.travel/ and keep it out of
# source control. Only the Student 1 backend receives this value.
LITEAPI_KEY=
