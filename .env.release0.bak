# Shared local Ollama configuration
IMPLEMENTER_MODEL=qwen2.5-coder:7b
# llama3.2:3b could not hold the reviewer's [OBSERVE] output contract, so the
# reviewer uses a 7b code model. Keep it different from IMPLEMENTER_MODEL so the
# review stays independent of the model that authored the proposal.
REVIEWER_MODEL=codellama:7b

# The accommodation application calls one model only and does not need a code
# model, so it stays on the small general-purpose model.
APPLICATION_MODEL=llama3.2:3b
